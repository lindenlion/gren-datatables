module Shared.ExampleData exposing (Person, presidents)

import Html



-- Demo data used in all examples


main =
    Html.text "This module exposes data to other modules."


type alias Person =
    { name : String
    , year : Int
    , city : String
    , state : String
    }


personWithNameYearCityState : String -> Int -> String -> String -> Person
personWithNameYearCityState name year city state =
    { name = name, year = year, city = city, state = state }


presidents : Array Person
