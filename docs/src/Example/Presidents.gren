module Example.Presidents exposing (Model, Msg(..), config, init, main, update, view)

import Browser
import DataTable as Table
import Html exposing (Html, div, h1, input, li, text, ul)
import Html.Attributes exposing (placeholder)
import Html.Events exposing (onInput)
import Shared.ExampleData as Data


main : Program {} Model Msg
main =
    Browser.sandbox
        { init = init Data.presidents
        , update = update
        , view = view
        }



-- MODEL


type alias Model =
    { people : Array Data.Person
    , tableState : Table.State
    , query : String
    }


init : Array Data.Person -> Model
init people =
    let
        model =
            { people = people
            , tableState = Table.initialSort "State"
            , query = ""
            }
    in
    model



-- UPDATE


type Msg
    = SetQuery String
    | SetTableState Table.State


update : Msg -> Model -> Model
update msg model =
    when msg is
        SetQuery newQuery ->
            { model | query = newQuery }

        SetTableState newState ->
            { model | tableState = newState }



-- VIEW


view : Model -> Html Msg
view { people, tableState, query } =
    let
        lowerQuery =
            String.toLower query

        acceptablePeople =
            Array.keepIf (String.contains lowerQuery << String.toLower << .name) people
    in
    div []
        [ h1 [] [ text "Sortable table." ]
        , div []
            [ text "Single click to set the sort order to that column. "
            , text "If the column was selected already, the sort order is reversed. "
            , text "Click elsewhere and release the click on column header to add that column to the end of the sort order (...then sort by Year). "
            , text "If the column was selected already, it is moved to the end of the sort order sequence. "
            ]
        , h1 [] [ text "Birthplaces of U.S. Presidents" ]
        , input [ placeholder "Search by Name", onInput SetQuery ] []
        , Table.view config tableState acceptablePeople
        ]


config : Table.Config Data.Person Msg
config =
    Table.config
        { toId = .name
        , toMsg = SetTableState
        , columns =
            [ Table.stringColumn "Name" .name
            , Table.intColumn "Year" .year
            , Table.stringColumn "City" .city
            , Table.stringColumn "State" .state
            ]
        }
