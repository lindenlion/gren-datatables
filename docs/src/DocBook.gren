module DocBook exposing (Model, Msg(..), init, main, update, view)

import Browser
import Example.Countries as Countries
import Example.Paginated as Paginated
import Example.Presidents as Presidents
import Html exposing (Html)
import Html.Attributes exposing (class, id, style)
import Html.Events exposing (onClick)
import Shared.ExampleData as Data


main : Program {} Model Msg
main =
    Browser.sandbox
        { init = init
        , update = update
        , view = view
        }


type Msg
    = SwitchExample ExampleShown
    | PresidentsMsg Presidents.Msg
    | PaginatedMsg Paginated.Msg
    | CountriesMsg Countries.Msg


init =
    { activeExample = ShowPresidents
    , presidents = Presidents.init Data.presidents
    , paginated = Paginated.init Data.presidents
    , countries = Countries.init Data.countries
    }


type alias Model =
    { activeExample : ExampleShown
    , presidents : Presidents.Model
    , paginated : Paginated.Model
    , countries : Countries.Model
    }


view : Model -> Html Msg
view model =
    let
        isActive variant =
            if model.activeExample == variant then
                [ class "active", Html.Attributes.tabindex -1 ]

            else
                []

        variants =
            Array.map
                (\variant -> Html.button ([ onClick <| SwitchExample variant ] ++ isActive variant) [ Html.text <| exampleName variant ])
                buttons
    in
    Html.div [ id "wrapper" ]
        [ Html.nav [ id "navigation" ] ([ Html.h3 [] [ Html.text "Examples" ] ] ++ variants)
        , Html.article [ id "example" ]
            [ when model.activeExample is
                ShowCountries ->
                    Countries.view model.countries |> Html.map CountriesMsg

                ShowPresidents ->
                    Presidents.view model.presidents |> Html.map PresidentsMsg

                ShowPaginated ->
                    Paginated.view model.paginated |> Html.map PaginatedMsg
            ]
        ]


update : Msg -> Model -> Model
update msg model =
    when msg is
        SwitchExample exampleToSwitchTo ->
            { model | activeExample = exampleToSwitchTo }

        CountriesMsg exampleMsg ->
            { model | countries = Countries.update exampleMsg <| .countries model }

        PresidentsMsg exampleMsg ->
            { model | presidents = Presidents.update exampleMsg <| .presidents model }

        PaginatedMsg exampleMsg ->
            { model | paginated = Paginated.update exampleMsg <| .paginated model }


type ExampleShown
    = ShowPresidents
    | ShowPaginated
    | ShowCountries


buttons =
    -- don't forget to add the example to this list, otherwise it won't show up...
    [ ShowPresidents, ShowCountries, ShowPaginated ]


exampleName : ExampleShown -> String
exampleName variant =
    when variant is
        ShowPresidents ->
            "Sorting"

        ShowCountries ->
            "Pagination"

        ShowPaginated ->
            "Scrolling Pagination"
