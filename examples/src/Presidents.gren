module Presidents exposing (Model, Msg(..), Person, config, init, main, presidents, update, view)

import Browser
import Html exposing (Html, div, h1, input, text, ul, li)
import Html.Attributes exposing (placeholder)
import Html.Events exposing (onInput)
import DataTable as Table

main : Program {} Model Msg
main =
    Browser.element
        { init = \{} -> init presidents
        , update = update
        , view = view
        , subscriptions = \_ -> Sub.none
        }



-- MODEL


type alias Model =
    { people : Array Person
    , tableState : Table.State
    , query : String
    }


init : Array Person -> { model : Model, command : Cmd Msg }
init people =
    let
        model =
            { people = people
            , tableState = Table.initialSort "State"
            , query = ""
            }
    in
    { model = model, command = Cmd.none }



-- UPDATE


type Msg
    = SetQuery String
    | SetTableState Table.State


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        SetQuery newQuery ->
            { model = { model | query = newQuery }
            , command = Cmd.none
            }

        SetTableState newState ->
            { model = { model | tableState = newState }
            , command = Cmd.none
            }



-- VIEW


view : Model -> Html Msg
view { people, tableState, query } =
    let
        lowerQuery =
            String.toLower query

        acceptablePeople =
            Array.keepIf (String.contains lowerQuery << String.toLower << .name) people
    in
    div []
        [ h1 [] [ text "Birthplaces of U.S. Presidents" ]
        , ul []
            [ li [] [ text "Single click on column header to add/move that column to the end of the sort order (...then sort by Year)" ]
            , li [] [ text "Double click to reset the sort order to just that column (Sort by Name)."]
            , li [] [ text "I don't like this user interaction, but it is, what it is for now. Suggestions for change welcome."]
            , li [] [ text "I'd prefer to make short click reset and long click add to sort order."]
          ]
        , div [][]
        , input [ placeholder "Search by Name", onInput SetQuery ] []
        , Table.view config tableState acceptablePeople
        ]


config : Table.Config Person Msg
config =
    Table.config
        { toId = .name
        , toMsg = SetTableState
        , columns =
            [ Table.stringColumn "Name" .name
            , Table.intColumn "Year" .year
            , Table.stringColumn "City" .city
            , Table.stringColumn "State" .state
            ]
        }



-- PEOPLE


type alias Person =
    { name : String
    , year : Int
    , city : String
    , state : String
    }

person name year city state =
    { name = name, year = year, city = city, state = state }

